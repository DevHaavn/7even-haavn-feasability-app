{
  "rewrites": [
    {
      "source": "/api/mcp/:secret",
      "destination": "/api/mcp?secret=:secret"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ],
  "crons": [
    {
      "path": "/api/chat-nudge",
      "schedule": "*/5 * * * *"
    }
  ]
}