{
  "id": "/atrium-chat.html",
  "name": "ATRIUM Chat",
  "short_name": "Chat",
  "description": "ATRIUM Chat, by 7X. Chat, tasks and meetings with your team, in its own window.",
  "start_url": "/atrium-chat.html?app=1",
  "scope": "/atrium-chat.html",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1b1c1f",
  "theme_color": "#1b1c1f",
  "icons": [
    {
      "src": "/icons/chat-icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/chat-icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/chat-icon-maskable-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+atriumchat",
      "url": "/atrium-chat.html?app=1&open=%s"
    }
  ]
}
