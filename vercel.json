{
  "redirects": [
    {
      "source": "/((?!(?:atrium-chat\\.html|atrium-notes\\.html|atrium-chat-assets\\.js|atrium-scheme\\.js|atrium-push-sw\\.js|atrium-speech/.*|atrium-chat-bg/.*|chat\\.webm|chat\\.webmanifest|haavn-black-bg\\.mp4|haavn-black-bg-poster\\.jpg|icons/.*|api/chat.*|api/auth/.*|favicon\\.ico)$).*)",
      "has": [
        {
          "type": "host",
          "value": "atrium-chat-7x.vercel.app"
        }
      ],
      "destination": "/atrium-chat.html?app=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp/:secret",
      "destination": "/api/mcp?secret=:secret"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ],
  "crons": [
    {
      "path": "/api/chat-nudge",
      "schedule": "*/5 * * * *"
    }
  ]
}
