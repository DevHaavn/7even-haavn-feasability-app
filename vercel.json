{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "atrium-chat-7x.vercel.app" }],
      "destination": "/atrium-chat.html?app=1",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/mcp/:secret",
      "destination": "/api/mcp?secret=:secret"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ],
  "crons": [
    {
      "path": "/api/chat-nudge",
      "schedule": "*/5 * * * *"
    }
  ]
}